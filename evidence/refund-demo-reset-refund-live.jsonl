nt": "probe_vector_recall", "pid": 60656, "filter": "((document_id == \"DEMO-REFUND-POLICY\" and version == \"1.0\")) and entry_type == \"policy\""}], "mcp": [{"event": "mcp_search_policy", "pid": 60656, "trace_id": "0e292601-4049-48fa-8fc9-9cf3ee4e926e", "tool_event_id": "08d2fb67-f0a8-4797-bd47-dece8cd0ed6b", "mcp_request_id": 3, "status": "ok", "policy_event_id": "6a8f173c-66fe-444f-b14b-f29edbbde47f", "mode": "formal", "requested_catalog_revision": null, "catalog_revision": 1}, {"event": "mcp_submit_mock_refund", "pid": 60656, "trace_id": "0e292601-4049-48fa-8fc9-9cf3ee4e926e", "tool_event_id": "323284ae-355a-4222-b2fb-f5fdada4dae8", "mcp_request_id": 3, "order_id": "DEMO-1001", "idempotency_key": "e78c7b85-1813-463a-9ea6-f966d56ba4c5", "status": "simulated_succeeded"}], "policy_retrieval": [{"event": "policy_retrieval", "pid": 60656, "policy_event_id": "6a8f173c-66fe-444f-b14b-f29edbbde47f", "mode": "formal", "catalog_revision": 1, "recalled": [{"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-003", "entry_type": "policy", "text": "可退款条件\n订单属于当前消费者、已支付、未发货且尚未成功退款时，可以办理整单原路退款。本演示不额外设置支付后退款期限，也不设置退款手续费。"}, {"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-004", "entry_type": "policy", "text": "不符合退款条件\n未支付的订单没有可退款的已支付款项，不办理退款。已发货的订单超出本演示支持范围，不办理退款；本演示不继续处理退货、物流或验收。"}, {"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-006", "entry_type": "policy", "text": "咨询与办理的区别\n询问退款政策、询问订单能否退款，不代表申请办理退款。只有消费者明确提出办理退款，才可以进入退款执行流程。表达存在歧义时，应先询问是否需要办理。订单号缺失时，应先询问订单号。"}, {"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-010", "entry_type": "policy", "text": "取消与更换订单\n退款执行开始前，消费者可以取消办理或更换订单。更换订单后，原订单的办理授权、查询结果和执行计划均不沿用。模拟退款已经执行成功后，不能通过对话取消，也不自动发起重新支付。"}, {"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-007", "entry_type": "policy", "text": "办理授权\n消费者明确申请对某笔订单办理退款后，系统可在规则校验通过时直接执行模拟退款，无需人工审批或额外确认。消费者的授权仅适用于当前指定订单，不自动延伸到其他订单。"}, {"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-009", "entry_type": "policy", "text": "已退款与重复请求\n同一订单只产生一笔成功的模拟退款。订单已经成功退款时，返回原模拟退款单号和原退款金额，说明该订单已完成模拟退款，不再次办理。更换会话或正常重启应用也不会为该订单生成第二笔退款；原记录保留至显式执行演示数据重置。"}, {"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-005", "entry_type": "policy", "text": "退款金额与去向\n退款金额为订单记录中的实际支付金额，金额币种为人民币。本演示不允许用户指定退款金额、收款账户或改变原支付渠道；不处理部分退款、优惠分摊和多订单合并退款。"}, {"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-001", "entry_type": "policy", "text": "适用业务\n本演示仅支持电商实物订单的未发货、整单、原路退款。订单、消费者身份和支付接口均为模拟数据。退款结果只代表模拟系统中的操作结果，不发生真实资金划转。"}], "ranked": [{"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-003", "entry_type": "policy", "text": "可退款条件\n订单属于当前消费者、已支付、未发货且尚未成功退款时，可以办理整单原路退款。本演示不额外设置支付后退款期限，也不设置退款手续费。"}, {"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-004", "entry_type": "policy", "text": "不符合退款条件\n未支付的订单没有可退款的已支付款项，不办理退款。已发货的订单超出本演示支持范围，不办理退款；本演示不继续处理退货、物流或验收。"}, {"document_id": "DEMO-REFUND-POLICY", "title": "演示退款政策与常见问题", "version": "1.0", "clause_id": "RF-001", "entry_type": "policy", "text": "适用业务\n本演示仅支持电商实物订单的未发货、整单、原路退款。订单、消费者身份和支付接口均为模拟数据。退款结果只代表模拟系统中的操作结果，不发生真实资金划转。"}]}], "database": {"dispatch": [["e78c7b85-1813-463a-9ea6-f966d56ba4c5", "succeeded", "MOCK-RF-1fb4116f57b74795bc81b3a6421df692", "0e292601-4049-48fa-8fc9-9cf3ee4e926e", null]], "refund": [["MOCK-RF-1fb4116f57b74795bc81b3a6421df692", 19900, "e78c7b85-1813-463a-9ea6-f966d56ba4c5"]]}}
